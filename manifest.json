{
  "manifest_version": 3,
  "name": "Climano",
  "short_name": "Climano",
  "version": "1.1.3",
  "description": "A calm, detailed local weather forecast with hourly conditions and a multi-day outlook.",
  "action": {
    "default_title": "Climano",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "geolocation"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://ipapi.co/*"
  ]
}
